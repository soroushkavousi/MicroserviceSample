###
# Simple product walkthrough — one example per endpoint (via gateway).
# Env: select "local" (http-client.env.json).
# Rider: product id is captured via response-handler script into {{productId}}.
###

@gateway = {{gateway}}

### List products
GET {{gateway}}/products?phrase=&page=1&pageSize=10
Accept: application/json

### Create product
POST {{gateway}}/products
Content-Type: application/json

{
  "name": "Product A",
  "price": 10.00,
  "description": "Description of product A"
}

> {%
client.global.set("productId", response.body.data.id);
%}

### Get product by ID
GET {{gateway}}/products/{{productId}}
Accept: application/json

### Update product by ID
PUT {{gateway}}/products/{{productId}}
Content-Type: application/json

{
  "name": "Updated Product",
  "price": 29.99,
  "description": "Updated description"
}

### Delete product by ID
DELETE {{gateway}}/products/{{productId}}
